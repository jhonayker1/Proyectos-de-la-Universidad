# Base de datos PostgreSQL
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cauchos_rey_def
# Opcional: si se define, tiene prioridad sobre las variables DB_*
# (por ejemplo sqlite:///./inventario.db para desarrollo sin PostgreSQL)
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/base

# Pool de conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_CONNECT_RETRIES=5
DB_RETRY_DELAY=2

# Moneda local (código de la tabla monedas) y zona horaria del negocio
LOCAL_CURRENCY=VES
TIMEZONE=America/Caracas

# Servidor
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Seguridad JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Administrador inicial (opcional, se crea una vez si el correo no existe)
# INITIAL_ADMIN_NAME=Administrador
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
